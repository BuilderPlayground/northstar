<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sign in to Northstar, your personal decision journal.">
  <title>Sign In | Northstar</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body class="auth-page">

  <main class="auth-layout">

    <!-- LEFT: SIGN-IN FORM -->
    <section class="auth-main">

      <header class="auth-header">

        <a href="/" class="auth-brand">
          <span>northstar</span>
          <span class="auth-logo">✳</span>
        </a>

        <a href="/" class="auth-back">← Back to home</a>

      </header>

      <div class="auth-content">

        <p class="auth-eyebrow">
          YOUR PERSONAL DECISION JOURNAL
        </p>

        <h1>
          Welcome<br>
          <span class="auth-accent">back.</span>
        </h1>

        <p class="auth-description">
          Your thoughts, decisions, and reflections are right where you left them. Pick up wherever you are.
        </p>

        <!-- AUTHENTICATION ERRORS -->
        <% if (message && message.length > 0) { %>
          <div class="auth-error" role="alert">
            <%= message %>
          </div>
        <% } %>

        <!-- SIGN-IN FORM -->
        <form action="/login" method="POST" class="auth-form">

          <div class="auth-field">

            <label for="email">Email address</label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="username"
              required>

          </div>

          <div class="auth-field">

            <label for="password">Password</label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required>

          </div>

          <button type="submit" class="auth-submit">
            Sign in to Northstar
          </button>

        </form>

        <p class="auth-switch">
          New to Northstar?
          <a href="/signup">Create an account</a>
        </p>

      </div>

      <footer class="auth-footer">
        NORTHSTAR ✳ — MAKE SPACE FOR WHAT MATTERS.
      </footer>

    </section>

    <!-- RIGHT: NORTHSTAR BRAND EXPERIENCE -->
    <aside class="auth-aside">

      <div class="auth-aside-header">
        <span class="auth-aside-symbol">✳</span>
        <span>A SPACE TO FIND YOUR DIRECTION.</span>
      </div>

      <div class="auth-aside-content">

        <p class="auth-aside-eyebrow">
          THE DECISION ROOM
        </p>

        <h2>
          Your life.<br>
          <span>Your direction.</span>
        </h2>

        <p class="auth-aside-description">
          Not every decision comes with an obvious answer. Give yourself room to explore what matters, document your thinking, and move forward with intention.
        </p>

        <!-- ILLUSTRATIVE JOURNAL PREVIEW -->
        <div class="auth-preview">

          <div class="auth-preview-header">
            <span>YOUR DECISION JOURNAL</span>
            <span>SAMPLE PREVIEW</span>
          </div>

          <div class="auth-preview-cards">

            <div class="auth-preview-card">
              <span>CONSIDERING</span>
              <strong>03</strong>
            </div>

            <div class="auth-preview-card">
              <span>DECIDED</span>
              <strong>05</strong>
            </div>

          </div>

          <div class="auth-preview-bottom">
            <span>✳</span>
            <p>Every direction begins with a decision.</p>
          </div>

        </div>

      </div>

      <div class="auth-aside-footer">
        YOUR CHOICES. YOUR DIRECTION. YOUR LIFE.
      </div>

    </aside>

  </main>

</body>
</html>